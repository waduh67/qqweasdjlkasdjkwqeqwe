#!/usr/bin/env bash
#
# Installer hub OpenVPN FTTH untuk "{{SERVER_NAME}}".
# Jalankan SEKALI di VPS ber-IP publik:
#   curl -fsSL "<APP_URL>/api/vpn/provision/install.sh?token=<NODE_TOKEN>" | sudo bash
# Idempoten: aman dijalankan ulang. Perangkat baru cukup ditambah dari dashboard —
# VPS tidak perlu disentuh lagi (verifikasi user & IP tetap lewat callback ke aplikasi).
#
set -euo pipefail

if [ "$(id -u)" -ne 0 ]; then
  echo "[ftth] Jalankan sebagai root (mis. lewat sudo)." >&2
  exit 1
fi

APP_URL="{{APP_URL}}"
NODE_TOKEN="{{NODE_TOKEN}}"
DIR=/etc/openvpn/server

echo "[ftth] Memasang OpenVPN untuk hub {{SERVER_NAME}} ..."
export DEBIAN_FRONTEND=noninteractive
if command -v apt-get >/dev/null 2>&1; then
  apt-get update -qq
  apt-get install -y -qq openvpn curl
elif command -v dnf >/dev/null 2>&1; then
  dnf install -y -q openvpn curl
else
  echo "[ftth] Manajer paket tak dikenal; pasang 'openvpn' + 'curl' manual lalu ulangi." >&2
  exit 1
fi

install -d -m 700 "$DIR"

cat > "$DIR/ca.crt" <<'FTTH_CA_CERT'
{{CA_CERT}}
FTTH_CA_CERT

cat > "$DIR/server.crt" <<'FTTH_SERVER_CERT'
{{SERVER_CERT}}
FTTH_SERVER_CERT

( umask 077; cat > "$DIR/server.key" <<'FTTH_SERVER_KEY'
{{SERVER_KEY}}
FTTH_SERVER_KEY
)
chmod 600 "$DIR/server.key"

cat > "$DIR/server.conf" <<'FTTH_SERVER_CONF'
{{SERVER_CONF}}
FTTH_SERVER_CONF

# Kredensial node (rahasia): dipakai skrip verify/connect untuk memanggil balik aplikasi.
( umask 077; cat > "$DIR/ftth-node.env" <<FTTH_NODE_ENV
APP_URL=$APP_URL
NODE_TOKEN=$NODE_TOKEN
FTTH_NODE_ENV
)
chmod 600 "$DIR/ftth-node.env"

# Verifikasi username/password tiap koneksi ke aplikasi (via-file: baris1=user, baris2=pass).
cat > "$DIR/ftth-verify.sh" <<'FTTH_VERIFY'
#!/usr/bin/env bash
set -euo pipefail
source /etc/openvpn/server/ftth-node.env
user=$(sed -n '1p' "$1")
pass=$(sed -n '2p' "$1")
code=$(curl -sS -o /dev/null -w '%{http_code}' -m 10 \
  --data-urlencode "token=$NODE_TOKEN" \
  --data-urlencode "username=$user" \
  --data-urlencode "password=$pass" \
  "$APP_URL/api/vpn/provision/authenticate" || echo 000)
[ "$code" = "204" ]
FTTH_VERIFY
chmod 755 "$DIR/ftth-verify.sh"

# Kunci IP overlay tetap. Aplikasi mengembalikan "ip mask port"; yang dipakai di sini hanya
# ip & mask untuk ifconfig-push. Penerusan port TIDAK lagi diurus di sini — lihat ftth-sync.sh.
cat > "$DIR/ftth-connect.sh" <<'FTTH_CONNECT'
#!/usr/bin/env bash
set -euo pipefail
source /etc/openvpn/server/ftth-node.env
config="$1"
line=$(curl -sS -m 10 \
  --data-urlencode "token=$NODE_TOKEN" \
  --data-urlencode "username=$common_name" \
  "$APP_URL/api/vpn/provision/client-connect" || true)
[ -n "$line" ] || exit 1
read -r ip mask port <<< "$line"
[ -n "$ip" ] && [ -n "$mask" ] || exit 1
printf 'ifconfig-push %s %s\n' "$ip" "$mask" > "$config"

# Telemetri liveness (best-effort, tak menggerbang tunnel): laporkan peer terhubung ke aplikasi.
curl -sS -m 10 -o /dev/null \
  --data-urlencode "token=$NODE_TOKEN" \
  --data-urlencode "username=$common_name" \
  "$APP_URL/api/vpn/provision/client-connected" >/dev/null 2>&1 || true

# Perangkat yang baru menyambung tak perlu menunggu timer: selaraskan penerusan port sekarang.
( /etc/openvpn/server/ftth-sync.sh >/dev/null 2>&1 & ) || true
exit 0
FTTH_CONNECT
chmod 755 "$DIR/ftth-connect.sh"

# Peer putus: cukup lapor liveness (best-effort; selalu exit 0). Aturan DNAT sengaja DIBIARKAN —
# aturan yang menunjuk IP overlay yang sedang tak dihuni tak menyakiti siapa pun, dan
# ftth-sync.sh yang berhak mencabutnya ketika penerusannya benar-benar dihapus operator.
cat > "$DIR/ftth-disconnect.sh" <<'FTTH_DISCONNECT'
#!/usr/bin/env bash
set -uo pipefail
source /etc/openvpn/server/ftth-node.env
curl -sS -m 10 -o /dev/null \
  --data-urlencode "token=$NODE_TOKEN" \
  --data-urlencode "username=$common_name" \
  "$APP_URL/api/vpn/provision/client-disconnected" >/dev/null 2>&1 || true
exit 0
FTTH_DISCONNECT
chmod 755 "$DIR/ftth-disconnect.sh"

# ------------------------------------------------------------
# Penyelaras penerusan port: aplikasi pemegang kebenaran, iptables cerminannya.
#
# Dulu DNAT dipasang saat client-connect ke port Winbox yang dipaku 8291. Tiga hal patah:
#   1. Perangkat yang port Winbox-nya dipindah jadi tak terjangkau, tanpa jalan keluar.
#   2. Satu perangkat cuma bisa punya satu pintu (tak bisa Winbox + SSH + API sekaligus).
#   3. Perubahan konfigurasi baru berlaku saat tunnelnya kebetulan putus-sambung.
# Sekarang daftar penerusan ditarik berkala dan direkonsiliasi: yang kurang dipasang, yang
# tak lagi ada dicabut. Efek sampingnya menyenangkan: aturan pulih sendiri sesudah VPS reboot.
#
# Hanya aturan bertanda komentar "ftth-vpn" yang boleh disentuh — aturan iptables milik
# operator (atau Docker) tak pernah ikut tersapu.
# ------------------------------------------------------------
cat > "$DIR/ftth-sync.sh" <<'FTTH_SYNC'
#!/usr/bin/env bash
set -uo pipefail
source /etc/openvpn/server/ftth-node.env
command -v iptables >/dev/null 2>&1 || exit 0

body=$(curl -sS -m 15 \
  --data-urlencode "token=$NODE_TOKEN" \
  "$APP_URL/api/vpn/provision/forwards" || true)
# Baris pertama WAJIB penanda. Aplikasi mati / balasan error / token dicabut => berhenti diam-diam
# TANPA menyentuh iptables: lebih baik aturan basi daripada semua perangkat mendadak tak terjangkau.
[ "$(printf '%s\n' "$body" | head -n1)" = "{{FORWARD_MARKER}}" ] || exit 0
desired=$(printf '%s\n' "$body" | tail -n +2 | awk 'NF==4')

# 1. Pasang yang belum ada (-C dulu supaya idempoten).
while read -r pub ip dev proto; do
  [ -n "${pub:-}" ] || continue
  iptables -t nat -C PREROUTING -p "$proto" --dport "$pub" \
    -m comment --comment "ftth-vpn" -j DNAT --to-destination "$ip:$dev" 2>/dev/null \
    || iptables -t nat -A PREROUTING -p "$proto" --dport "$pub" \
      -m comment --comment "ftth-vpn" -j DNAT --to-destination "$ip:$dev" 2>/dev/null || true
done <<< "$desired"

# 2. Cabut aturan kami yang tak lagi diinginkan (port dihapus, sasaran diubah, akun dinonaktifkan).
iptables -t nat -S PREROUTING 2>/dev/null | grep -- '--comment ftth-vpn' | while read -r rule; do
  pub=$(printf '%s' "$rule" | sed -n 's/.*--dport \([0-9]*\).*/\1/p')
  dest=$(printf '%s' "$rule" | sed -n 's/.*--to-destination \([^ ]*\).*/\1/p')
  proto=$(printf '%s' "$rule" | sed -n 's/.*-p \([a-z]*\).*/\1/p')
  [ -n "$pub" ] && [ -n "$dest" ] || continue
  printf '%s\n' "$desired" | grep -qxF "$pub ${dest%:*} ${dest##*:} $proto" && continue
  iptables -t nat ${rule/#-A/-D} 2>/dev/null || true
done
exit 0
FTTH_SYNC
chmod 755 "$DIR/ftth-sync.sh"

# Timer systemd: menit-menitan, cukup cepat untuk operator yang baru memindah port perangkatnya.
cat > /etc/systemd/system/ftth-vpn-sync.service <<'FTTH_SYNC_UNIT'
[Unit]
Description=Selaraskan penerusan port FTTH VPN dengan aplikasi
After=network-online.target

[Service]
Type=oneshot
ExecStart=/etc/openvpn/server/ftth-sync.sh
FTTH_SYNC_UNIT

cat > /etc/systemd/system/ftth-vpn-sync.timer <<'FTTH_SYNC_TIMER'
[Unit]
Description=Jalankan penyelaras penerusan port FTTH VPN secara berkala

[Timer]
OnBootSec=30s
OnUnitActiveSec={{SYNC_INTERVAL}}
AccuracySec=10s

[Install]
WantedBy=timers.target
FTTH_SYNC_TIMER

# Aktifkan IP forwarding (perangkat overlay bisa dijangkau lewat hub).
echo 'net.ipv4.ip_forward=1' > /etc/sysctl.d/99-ftth-vpn.conf
sysctl -q -w net.ipv4.ip_forward=1

# Rute-balik trafik remote (DNAT -> Winbox) lewat tunnel: MASQUERADE ke subnet tunnel supaya
# perangkat membalas ke hub (10.8.0.1), plus izinkan FORWARD subnet tunnel (host Docker set DROP).
TUN_CIDR="{{TUNNEL_CIDR}}"
if command -v iptables >/dev/null 2>&1; then
  iptables -t nat -C POSTROUTING -d "$TUN_CIDR" -j MASQUERADE 2>/dev/null \
    || iptables -t nat -A POSTROUTING -d "$TUN_CIDR" -j MASQUERADE 2>/dev/null || true
  iptables -C FORWARD -d "$TUN_CIDR" -j ACCEPT 2>/dev/null \
    || iptables -I FORWARD 1 -d "$TUN_CIDR" -j ACCEPT 2>/dev/null || true
  iptables -C FORWARD -s "$TUN_CIDR" -j ACCEPT 2>/dev/null \
    || iptables -I FORWARD 1 -s "$TUN_CIDR" -j ACCEPT 2>/dev/null || true

  # Sapu DNAT peninggalan installer lama (port dipaku ke 8291, tanpa komentar penanda). Kalau
  # dibiarkan, aturan lama duduk LEBIH DULU di PREROUTING dan menang atas aturan baru — port
  # perangkat yang sudah diubah operator tak akan pernah berlaku sampai VPS-nya reboot.
  # Amannya terjaga: hanya DNAT yang menunjuk ke dalam subnet tunnel ini yang dicabut.
  TUN_PREFIX="${TUN_CIDR%.*}."
  iptables -t nat -S PREROUTING 2>/dev/null \
    | grep -- '-j DNAT' | grep -v -- '--comment ftth-vpn' | grep -F -- "--to-destination $TUN_PREFIX" \
    | while read -r rule; do iptables -t nat ${rule/#-A/-D} 2>/dev/null || true; done
fi

systemctl daemon-reload
systemctl enable ftth-vpn-sync.timer
systemctl restart ftth-vpn-sync.timer
# Jangan menunggu tik pertama: pasang penerusan port sekarang juga.
"$DIR/ftth-sync.sh" || true

# RESTART, bukan sekadar `enable --now`: skrip ini memang dirancang untuk dijalankan ulang
# (mis. sesudah protokol hub diubah UDP -> TCP), dan `--now` tak menyentuh service yang sudah
# jalan — daemonnya akan terus memegang config lama sampai kiamat, padahal berkasnya sudah
# berganti. Gejalanya menyesatkan: `server.conf` bilang tcp, `ss` bilang masih udp.
systemctl enable openvpn-server@server
systemctl restart openvpn-server@server
sleep 1
systemctl --no-pager --full status openvpn-server@server 2>/dev/null | head -n 5 || true

echo "[ftth] Selesai. Hub '{{SERVER_NAME}}' mendengarkan di {{HOST}}:{{PORT}}/{{PROTO}}."
echo "[ftth] Tambah perangkat dari dashboard, lalu tempel skrip RouterOS di Mikrotik-nya."
echo "[ftth] Penerusan port diselaraskan tiap {{SYNC_INTERVAL}} (systemctl status ftth-vpn-sync.timer)."
