#!/usr/bin/env bash
#
# Installer hub OpenVPN FTTH untuk "{{SERVER_NAME}}".
# Jalankan SEKALI di VPS ber-IP publik:
#   curl -fsSL "<APP_URL>/api/vpn/provision/install.sh?token=<NODE_TOKEN>" | sudo bash
# Idempoten: aman dijalankan ulang. Perangkat baru cukup ditambah dari dashboard —
# VPS tidak perlu disentuh lagi (verifikasi user & IP tetap lewat callback ke aplikasi).
#
set -euo pipefail

if [ "$(id -u)" -ne 0 ]; then
  echo "[ftth] Jalankan sebagai root (mis. lewat sudo)." >&2
  exit 1
fi

APP_URL="{{APP_URL}}"
NODE_TOKEN="{{NODE_TOKEN}}"
DIR=/etc/openvpn/server

echo "[ftth] Memasang OpenVPN untuk hub {{SERVER_NAME}} ..."
export DEBIAN_FRONTEND=noninteractive
if command -v apt-get >/dev/null 2>&1; then
  apt-get update -qq
  apt-get install -y -qq openvpn curl
elif command -v dnf >/dev/null 2>&1; then
  dnf install -y -q openvpn curl
else
  echo "[ftth] Manajer paket tak dikenal; pasang 'openvpn' + 'curl' manual lalu ulangi." >&2
  exit 1
fi

install -d -m 700 "$DIR"

cat > "$DIR/ca.crt" <<'FTTH_CA_CERT'
{{CA_CERT}}
FTTH_CA_CERT

cat > "$DIR/server.crt" <<'FTTH_SERVER_CERT'
{{SERVER_CERT}}
FTTH_SERVER_CERT

( umask 077; cat > "$DIR/server.key" <<'FTTH_SERVER_KEY'
{{SERVER_KEY}}
FTTH_SERVER_KEY
)
chmod 600 "$DIR/server.key"

cat > "$DIR/server.conf" <<'FTTH_SERVER_CONF'
{{SERVER_CONF}}
FTTH_SERVER_CONF

# Kredensial node (rahasia): dipakai skrip verify/connect untuk memanggil balik aplikasi.
( umask 077; cat > "$DIR/ftth-node.env" <<FTTH_NODE_ENV
APP_URL=$APP_URL
NODE_TOKEN=$NODE_TOKEN
FTTH_NODE_ENV
)
chmod 600 "$DIR/ftth-node.env"

# Verifikasi username/password tiap koneksi ke aplikasi (via-file: baris1=user, baris2=pass).
cat > "$DIR/ftth-verify.sh" <<'FTTH_VERIFY'
#!/usr/bin/env bash
set -euo pipefail
source /etc/openvpn/server/ftth-node.env
user=$(sed -n '1p' "$1")
pass=$(sed -n '2p' "$1")
code=$(curl -sS -o /dev/null -w '%{http_code}' -m 10 \
  --data-urlencode "token=$NODE_TOKEN" \
  --data-urlencode "username=$user" \
  --data-urlencode "password=$pass" \
  "$APP_URL/api/vpn/provision/authenticate" || echo 000)
[ "$code" = "204" ]
FTTH_VERIFY
chmod 755 "$DIR/ftth-verify.sh"

# Kunci IP overlay tetap + pasang DNAT port publik -> Winbox perangkat. Aplikasi mengembalikan
# "ip mask port": baris ifconfig-push ditulis ke berkas config, port di-DNAT ke <ip>:{{DEVICE_PORT}}.
cat > "$DIR/ftth-connect.sh" <<'FTTH_CONNECT'
#!/usr/bin/env bash
set -euo pipefail
source /etc/openvpn/server/ftth-node.env
config="$1"
line=$(curl -sS -m 10 \
  --data-urlencode "token=$NODE_TOKEN" \
  --data-urlencode "username=$common_name" \
  "$APP_URL/api/vpn/provision/client-connect" || true)
[ -n "$line" ] || exit 1
read -r ip mask port <<< "$line"
[ -n "$ip" ] && [ -n "$mask" ] || exit 1
printf 'ifconfig-push %s %s\n' "$ip" "$mask" > "$config"

# DNAT port publik hub -> Winbox perangkat. Best-effort: dibungkus { } || true + exit 0 supaya
# kegagalan iptables TAK PERNAH membuat skrip exit != 0 (OpenVPN akan menolak klien bila begitu).
if [ -n "$port" ] && command -v iptables >/dev/null 2>&1; then
  {
    dest="$ip:{{DEVICE_PORT}}"
    # Bersihkan DNAT usang di port sama menuju tujuan lain (IP overlay bisa dipakai ulang lintas-tenant).
    iptables -t nat -S PREROUTING 2>/dev/null \
      | awk -v p="$port" -v d="$dest" '$0 ~ ("--dport "p" ") && /-j DNAT/ && $0 !~ d {sub(/^-A/,"-D"); print}' \
      | while read -r rule; do iptables -t nat $rule 2>/dev/null || true; done
    iptables -t nat -C PREROUTING -p tcp --dport "$port" -j DNAT --to-destination "$dest" 2>/dev/null \
      || iptables -t nat -A PREROUTING -p tcp --dport "$port" -j DNAT --to-destination "$dest" 2>/dev/null || true
  } || true
fi

# Telemetri liveness (best-effort, tak menggerbang tunnel): laporkan peer terhubung ke aplikasi.
curl -sS -m 10 -o /dev/null \
  --data-urlencode "token=$NODE_TOKEN" \
  --data-urlencode "username=$common_name" \
  "$APP_URL/api/vpn/provision/client-connected" >/dev/null 2>&1 || true
exit 0
FTTH_CONNECT
chmod 755 "$DIR/ftth-connect.sh"

# Lepas DNAT port publik saat perangkat putus (best-effort; selalu exit 0).
cat > "$DIR/ftth-disconnect.sh" <<'FTTH_DISCONNECT'
#!/usr/bin/env bash
set -uo pipefail
source /etc/openvpn/server/ftth-node.env
line=$(curl -sS -m 10 \
  --data-urlencode "token=$NODE_TOKEN" \
  --data-urlencode "username=$common_name" \
  "$APP_URL/api/vpn/provision/client-connect" || true)
[ -n "$line" ] || exit 0
read -r ip mask port <<< "$line"
if [ -n "${port:-}" ] && [ -n "${ip:-}" ] && command -v iptables >/dev/null 2>&1; then
  iptables -t nat -D PREROUTING -p tcp --dport "$port" -j DNAT --to-destination "$ip:{{DEVICE_PORT}}" 2>/dev/null || true
fi

# Telemetri liveness (best-effort): laporkan peer putus ke aplikasi supaya statusnya offline.
curl -sS -m 10 -o /dev/null \
  --data-urlencode "token=$NODE_TOKEN" \
  --data-urlencode "username=$common_name" \
  "$APP_URL/api/vpn/provision/client-disconnected" >/dev/null 2>&1 || true
exit 0
FTTH_DISCONNECT
chmod 755 "$DIR/ftth-disconnect.sh"

# Aktifkan IP forwarding (perangkat overlay bisa dijangkau lewat hub).
echo 'net.ipv4.ip_forward=1' > /etc/sysctl.d/99-ftth-vpn.conf
sysctl -q -w net.ipv4.ip_forward=1

# Rute-balik trafik remote (DNAT -> Winbox) lewat tunnel: MASQUERADE ke subnet tunnel supaya
# perangkat membalas ke hub (10.8.0.1), plus izinkan FORWARD subnet tunnel (host Docker set DROP).
TUN_CIDR="{{TUNNEL_CIDR}}"
if command -v iptables >/dev/null 2>&1; then
  iptables -t nat -C POSTROUTING -d "$TUN_CIDR" -j MASQUERADE 2>/dev/null \
    || iptables -t nat -A POSTROUTING -d "$TUN_CIDR" -j MASQUERADE 2>/dev/null || true
  iptables -C FORWARD -d "$TUN_CIDR" -j ACCEPT 2>/dev/null \
    || iptables -I FORWARD 1 -d "$TUN_CIDR" -j ACCEPT 2>/dev/null || true
  iptables -C FORWARD -s "$TUN_CIDR" -j ACCEPT 2>/dev/null \
    || iptables -I FORWARD 1 -s "$TUN_CIDR" -j ACCEPT 2>/dev/null || true
fi

# RESTART, bukan sekadar `enable --now`: skrip ini memang dirancang untuk dijalankan ulang
# (mis. sesudah protokol hub diubah UDP -> TCP), dan `--now` tak menyentuh service yang sudah
# jalan — daemonnya akan terus memegang config lama sampai kiamat, padahal berkasnya sudah
# berganti. Gejalanya menyesatkan: `server.conf` bilang tcp, `ss` bilang masih udp.
systemctl enable openvpn-server@server
systemctl restart openvpn-server@server
sleep 1
systemctl --no-pager --full status openvpn-server@server 2>/dev/null | head -n 5 || true

echo "[ftth] Selesai. Hub '{{SERVER_NAME}}' mendengarkan di {{HOST}}:{{PORT}}/{{PROTO}}."
echo "[ftth] Tambah perangkat dari dashboard, lalu tempel skrip RouterOS di Mikrotik-nya."
