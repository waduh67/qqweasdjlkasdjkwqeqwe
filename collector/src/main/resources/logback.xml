<configuration>
    <!-- Keluaran ringkas: collector berjalan di mesin operator, dan lognya sering
         dibaca lewat SSH tanpa alat bantu apa pun. -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{20} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="org.snmp4j" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
