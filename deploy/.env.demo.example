# ============================================================================
# Template environment SERVER SIMULATOR. Salin ke `.env` DI SERVER
# (/opt/ftth-demo) lalu isi bila perlu:
#   cp deploy/.env.demo.example .env
#
# Ini rig-uji peniru-protokol (docker-compose.demo.yml) = simulator + radius-db
# saja, dipakai aplikasi PRODUKSI buat testing SNMP/isolir. Bukan produksi dan
# tak ada app/web di sini, jadi cukup mengatur asal image simulator.
# ============================================================================

# ---- Image simulator dari GitHub Container Registry (GHCR) ----
# Samakan dengan owner repo GitHub (yang dipush CI). Tag "latest" didorong tiap deploy.
IMAGE_PREFIX=ghcr.io/waduh67
IMAGE_TAG=latest
