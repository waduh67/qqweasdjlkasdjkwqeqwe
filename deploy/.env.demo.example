# ============================================================================
# Template environment SERVER DEMO. Salin ke `.env` DI SERVER (/opt/ftth-demo)
# lalu isi bila perlu:
#   cp deploy/.env.demo.example .env
#
# Ini stack DEMO peniru-protokol (docker-compose.demo.yml) — bukan produksi.
# Secret app (jwt/encryption/S3/DB) pakai DEFAULT DEV dari image, jadi hanya
# perlu mengatur asal image + alamat situs di sini.
# ============================================================================

# ---- Image dari GitHub Container Registry (GHCR) ----
# Samakan dengan owner repo GitHub (yang dipush CI). Tag "latest" didorong tiap deploy.
IMAGE_PREFIX=ghcr.io/waduh67
IMAGE_TAG=latest

# ---- CORS ----
# Origin publik demo. Samakan dengan alamat yang diakses browser (HTTPS + domain).
# (Stack demo TIDAK punya Caddy sendiri — ingress via Caddy prod co-located, jadi
#  tak ada FTTH_SITE_ADDRESS di sini; lihat header docker-compose.demo.yml.)
FTTH_CORS_ORIGINS=https://simulator-ftth.karuhundeveloper.com
