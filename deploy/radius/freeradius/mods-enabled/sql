# Modul SQL FreeRADIUS → PostgreSQL (service radius-db). Kredensial diambil dari
# environment lewat $ENV{...} (FreeRADIUS 3.x meng-expand ini saat parse config),
# jadi tidak ada secret tertulis di file — semua di `.env`.
#
# Query bawaan (authorize/accounting/post-auth) diikutkan dari mods-config/sql yang
# sudah ada di image resmi; di sini kita hanya atur koneksi + tabel.
sql {
    dialect = "postgresql"
    driver = "rlm_sql_${dialect}"

    server    = "$ENV{RADIUS_DB_HOST}"
    port      = $ENV{RADIUS_DB_PORT}
    login     = "$ENV{RADIUS_DB_USER}"
    password  = "$ENV{RADIUS_DB_PASSWORD}"
    radius_db = "$ENV{RADIUS_DB_NAME}"

    # Daftar BRAS klien dibaca dari tabel `nas` (RADIUS-as-a-service, bukan lagi dari
    # clients.conf/.env): tenant daftarkan BRAS di UI → server menulis satu baris `nas`
    # (nasname=IP, secret, shortname=kode tenant). Zero restart, zero secret di file.
    read_clients = yes
    client_table = "nas"

    # Kunci SQL per-tenant (inti RADIUS-as-a-service). FreeRADIUS sudah mencocokkan
    # request ke satu klien/BRAS lewat source-IP+secret (anti-spoof); shortname klien =
    # KODE TENANT (kolom nas.shortname). Kita prefix-kan ke User-Name sehingga
    # radcheck/radusergroup/radacct di-key "{kodeTenant}:{username}". Efek: username
    # telanjang boleh KEMBAR antar-tenant (tenantA:budi ≠ tenantB:budi) sementara CPE
    # pelanggan tetap mengetik "budi" saja. Grup plan pakai UUID → aman tanpa prefix.
    # Server WAJIB menulis radcheck dengan format kunci yang identik (lihat S1).
    sql_user_name = "%{client:shortname}:%{User-Name}"

    # Dipakai queries.conf bawaan untuk memetakan grup — wajib ada walau fitur grup
    # tak dipakai, kalau tidak radiusd gagal parse. "SQL-Group" atribut kamus bawaan.
    group_attribute = "SQL-Group"

    # Kolom-kolom baku FreeRADIUS.
    acct_table1 = "radacct"
    acct_table2 = "radacct"
    postauth_table = "radpostauth"
    authcheck_table = "radcheck"
    authreply_table = "radreply"
    groupcheck_table = "radgroupcheck"
    groupreply_table = "radgroupreply"
    usergroup_table = "radusergroup"

    pool {
        start = 1
        min = 1
        max = 5
        spare = 1
        idle_timeout = 60
    }

    # Query SQL siap-pakai per dialek dari image resmi.
    $INCLUDE ${modconfdir}/${.:name}/main/${dialect}/queries.conf
}
