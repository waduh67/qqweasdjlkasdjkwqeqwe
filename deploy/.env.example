# ============================================================================
# Template environment PRODUKSI. Salin ke `.env` DI VPS lalu isi nilai asli.
#   cp .env.example .env  &&  nano .env
#
# File `.env` (berisi secret sungguhan) TIDAK boleh di-commit — sudah diabaikan
# .gitignore. Yang ini (.env.example) aman di repo karena hanya berisi contoh.
# ============================================================================

# ---- Alamat situs (dipakai Caddy) ----
# Punya domain? isi domainnya -> HTTPS otomatis. Belum? isi ":80" -> HTTP + IP.
FTTH_SITE_ADDRESS=app.contoh.com

# ---- Image dari GitHub Container Registry (GHCR) ----
# Disamakan dengan owner repo GitHub kamu. Tag "latest" didorong tiap deploy.
IMAGE_PREFIX=ghcr.io/fajarxfce
IMAGE_TAG=latest

# ---- Database (Postgres + PostGIS + TimescaleDB) ----
FTTH_DB_NAME=ftth
FTTH_DB_USER=ftth
# Password role aplikasi. Pakai huruf+angka saja (hindari kutip/tanda baca aneh).
FTTH_DB_PASSWORD=ganti-password-db-yang-kuat
# Password superuser 'postgres' (hanya internal, tidak dipublikasikan ke luar).
POSTGRES_SUPER_PASSWORD=ganti-password-superuser-yang-kuat

# ---- Secret keamanan (WAJIB, masing-masing >= 32 byte, HARUS berbeda) ----
# Bikin nilainya dengan:  openssl rand -base64 48
FTTH_JWT_SECRET=ganti-dengan-hasil-openssl-rand
FTTH_ENCRYPTION_SECRET=ganti-dengan-hasil-openssl-rand-yang-lain

# ---- CORS ----
# Sama-origin (web & API di domain yang sama) sebenarnya tak memicu CORS, tapi
# isi saja URL situsnya sebagai jaring pengaman.
FTTH_CORS_ORIGINS=https://app.contoh.com

# ---- Akun admin platform (dibuat sekali saat startup pertama) ----
FTTH_PLATFORM_ADMIN_EMAIL=admin@contoh.com
FTTH_PLATFORM_ADMIN_PASSWORD=ganti-password-admin-yang-kuat
# Di produksi: JANGAN seed tenant demo.
FTTH_SEED_DEMO=false

# ---- Object storage bukti pengerjaan (MinIO internal) ----
FTTH_S3_ACCESS_KEY=ftth
FTTH_S3_SECRET_KEY=ganti-minio-password-min-8-karakter
FTTH_S3_BUCKET=ftth-evidence

# ---- VPN hub (remote Mikrotik tanpa IP publik) ----
# URL publik aplikasi ini. Di-embed ke perintah pasang OpenVPN di VPS supaya hub
# bisa callback ke sini saat perangkat konek (verifikasi user + kunci overlay IP).
# WAJIB diisi kalau mau pakai fitur VPN; samakan dengan domain/HTTPS aplikasi.
FTTH_VPN_PUBLIC_BASE_URL=https://app.contoh.com
