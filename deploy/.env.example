# ============================================================================
# Template environment PRODUKSI. Salin ke `.env` DI VPS lalu isi nilai asli.
#   cp .env.example .env  &&  nano .env
#
# File `.env` (berisi secret sungguhan) TIDAK boleh di-commit — sudah diabaikan
# .gitignore. Yang ini (.env.example) aman di repo karena hanya berisi contoh.
# ============================================================================

# ---- Alamat situs (dipakai Caddy) ----
# Punya domain? isi domainnya -> HTTPS otomatis. Belum? isi ":80" -> HTTP + IP.
FTTH_SITE_ADDRESS=app.contoh.com

# ---- Image dari GitHub Container Registry (GHCR) ----
# Disamakan dengan owner repo GitHub kamu. Tag "latest" didorong tiap deploy.
IMAGE_PREFIX=ghcr.io/fajarxfce
IMAGE_TAG=latest

# ---- Database (Postgres + PostGIS + TimescaleDB) ----
FTTH_DB_NAME=ftth
FTTH_DB_USER=ftth
# Password role aplikasi. Pakai huruf+angka saja (hindari kutip/tanda baca aneh).
FTTH_DB_PASSWORD=ganti-password-db-yang-kuat
# Password superuser 'postgres' (hanya internal, tidak dipublikasikan ke luar).
POSTGRES_SUPER_PASSWORD=ganti-password-superuser-yang-kuat

# ---- Cadangan otomatis (service `backup` & `backup-radius`) ----
# Tiap malam kedua database di-dump ke folder ./backups di VPS ini, lalu cadangan yang
# lebih tua dari BACKUP_RETENTION_DAYS dibuang. Jam di bawah memakai BACKUP_TZ, jadi
# isi zona waktumu sendiri kalau mau "jam 2 pagi" berarti jam 2 pagi di sini.
#
# INGAT: cadangan yang cuma ada di VPS yang sama TIDAK menyelamatkanmu kalau VPS-nya
# yang hilang. Salin keluar berkala (lihat "Bagian M" di DEPLOY.md).
BACKUP_TZ=Asia/Jakarta
BACKUP_AT=02:30
BACKUP_RADIUS_AT=03:00
BACKUP_RETENTION_DAYS=14

# ---- Secret keamanan (WAJIB, masing-masing >= 32 byte, HARUS berbeda) ----
# Bikin nilainya dengan:  openssl rand -base64 48
FTTH_JWT_SECRET=ganti-dengan-hasil-openssl-rand
FTTH_ENCRYPTION_SECRET=ganti-dengan-hasil-openssl-rand-yang-lain

# ---- CORS ----
# Sama-origin (web & API di domain yang sama) sebenarnya tak memicu CORS, tapi
# isi saja URL situsnya sebagai jaring pengaman.
FTTH_CORS_ORIGINS=https://app.contoh.com

# ---- Akun admin platform (dibuat sekali saat startup pertama) ----
FTTH_PLATFORM_ADMIN_EMAIL=admin@contoh.com
FTTH_PLATFORM_ADMIN_PASSWORD=ganti-password-admin-yang-kuat
# Di produksi: JANGAN seed tenant demo.
FTTH_SEED_DEMO=false

# ---- Object storage bukti pengerjaan (MinIO internal) ----
FTTH_S3_ACCESS_KEY=ftth
FTTH_S3_SECRET_KEY=ganti-minio-password-min-8-karakter
FTTH_S3_BUCKET=ftth-evidence

# ---- RADIUS (FreeRADIUS + Postgres, jalan di stack ini) ----
# Server RADIUS untuk auth PPPoE + accounting. Mikrotik menembak ke IP VPS ini
# (buka 1812/udp & 1813/udp di NSG/firewall, batasi ke IP Mikrotik).
#
# Model RADIUS-as-a-service: TAK ADA client BRAS di .env lagi. Tenant mendaftarkan
# BRAS-nya sendiri lewat UI (nama, IP, shared secret) → server menulis baris `nas`
# di DB ini → FreeRADIUS memuat klien dari tabel `nas` (read_clients=yes).
#
# Tiga nilai di bawah dipakai bertiga: service radius-db (bikin DB), freeradius
# (koneksi SQL), dan server aplikasi (menulis otorisasi + baca radacct + daftar klien
# `nas`). Kredensialnya rahasia platform, bukan input tenant.
RADIUS_DB_NAME=radius
RADIUS_DB_USER=radius
# Password DB RADIUS — pakai openssl rand -base64 32.
RADIUS_DB_PASSWORD=ganti-password-db-radius-yang-kuat
#
# Alamat publik server RADIUS yang DITAMPILKAN ke tenant di UI (kartu "Arahkan router
# ke RADIUS ini" + skrip RouterOS siap-salin). Isi IP/host publik VPS ini. Kosong = UI
# menandai "belum dikonfigurasi" (auth tetap jalan; hanya panduan yang jadi placeholder).
FTTH_RADIUS_PUBLIC_HOST=20.11.22.33

# ---- CPE / TR-069 (GenieACS, jalan di stack ini) ----
# Router/ONT pelanggan dikelola lewat GenieACS. Perangkatlah yang MENGHUBUNGI VPS
# ini, jadi dua port di bawah harus terbuka di NSG/firewall — dan sebisanya dibatasi
# ke rentang IP jaringan akses pelangganmu, bukan seluruh internet.
#
#   7547 (cwmp) perangkat mengirim Inform ke sini — wajib
#   7567 (fs)   perangkat mengunduh firmware dari sini — hanya kalau pakai upgrade
#
# Port NBI (7557, API admin TANPA otentikasi) TIDAK dibuka & tak perlu diisi di sini:
# hanya server aplikasi yang memakainya, lewat jaringan internal compose.
#
# Host/IP publik VPS ini. Dipakai merakit URL unduh firmware yang dikirim ke perangkat
# (http://<host>:7567/<berkas>). Kosong = URL memakai hostname container → unduhan
# firmware GAGAL di sisi perangkat. Fitur lain (WiFi, reboot, diagnostik) tetap jalan.
FTTH_CPE_PUBLIC_HOST=20.11.22.33
# Ganti hanya kalau port bawaan bentrok (samakan dengan yang dibuka di firewall).
FTTH_CPE_CWMP_PORT=7547
FTTH_CPE_FS_PORT=7567
# Seberapa sering proyeksi CPE ditarik dari ACS, dan ambang "online" dari Inform terakhir.
FTTH_CPE_SYNC_INTERVAL=PT5M
FTTH_CPE_ONLINE_STALE_AFTER=PT15M
# Berkas uji untuk tombol "Uji Kecepatan" (TR-143). PERANGKAT yang mengunduhnya, jadi
# taruh di alamat yang terjangkau pelanggan. Default bawaan (speedtest.tele2.net) sudah
# DIMATIKAN Tele2 — biarkan begitu berarti uji kecepatan selalu gagal.
FTTH_CPE_DIAGNOSTICS_DOWNLOAD_URL=http://speedtest.tele2.net/10MB.zip

# ---- Email keluar (SMTP platform) ----
# SATU SMTP untuk semua tenant. Dipakai pesan transaksional yang tak boleh menumpang
# gateway WhatsApp tenant — sekarang: kode "lupa password" portal pelanggan.
# Kosongkan FTTH_MAIL_FROM kalau belum punya SMTP: email jatuh ke log server (aman, tapi
# pelanggan yang cuma punya email di data ISP tak akan bisa memulihkan akunnya sendiri).
# Pakai domain yang SPF/DKIM-nya benar, kalau tidak kodenya berakhir di folder spam.
FTTH_MAIL_HOST=smtp.contoh.com
FTTH_MAIL_PORT=587
FTTH_MAIL_USERNAME=no-reply@contoh.com
FTTH_MAIL_PASSWORD=ganti-dengan-sandi-smtp
FTTH_MAIL_FROM=no-reply@contoh.com
FTTH_MAIL_FROM_NAME=NetOps Console

# ---- Pembayaran (gateway Pivot) ----
# URL publik aplikasi untuk halaman balik Pivot mode REDIRECT (<base>/paid, /failed, /expired).
# WAJIB diisi bila menagih via Pivot; kosong = charge gagal & tautan bayar tak terbit
# ("Tautan bayar belum siap — hubungi admin platform"). Samakan dgn domain/HTTPS aplikasi.
FTTH_BILLING_PIVOT_REDIRECT_BASE_URL=https://app.contoh.com

# ---- VPN hub (remote Mikrotik tanpa IP publik) ----
# URL publik aplikasi ini. Di-embed ke perintah pasang OpenVPN di VPS supaya hub
# bisa callback ke sini saat perangkat konek (verifikasi user + kunci overlay IP).
# WAJIB diisi kalau mau pakai fitur VPN; samakan dengan domain/HTTPS aplikasi.
FTTH_VPN_PUBLIC_BASE_URL=https://app.contoh.com
# Rentang port publik TCP di hub untuk remote Winbox (satu port unik per akun VPN,
# di-DNAT ke <overlay>:8291). Buka rentang ini di firewall/NSG VPS. Default 20000-40000.
FTTH_VPN_REMOTE_PORT_MIN=20000
FTTH_VPN_REMOTE_PORT_MAX=40000
